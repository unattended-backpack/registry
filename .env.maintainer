# Registry maintainer defaults (committed). Loaded before `.env`, so a local
# `.env` overrides anything set here.

# The email domain whose senders may hold profiles. Pinned immutably at
# construction; the Registry compares it byte for byte against the domain the
# email circuit reveals.
DOMAIN=ethereum.org

# The CreateX factory, deployed at the same address on virtually every chain.
CREATEX=0xba5Ed099633D3B313e4D5F7bdc1305d3c28ba5Ed
